# Токен панели-бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID администраторов (можно несколько через запятую): узнать можно у @userinfobot
ADMIN_IDS=123456789

# Ключи Telegram API с https://my.telegram.org (нужны для подключения аккаунтов)
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Необязательно. Прокси, если Telegram API недоступен напрямую.
# Примеры: socks5://127.0.0.1:1080  |  socks5://user:pass@host:port  |  http://127.0.0.1:8080
# Для socks-прокси нужен PySocks: pip install pysocks
